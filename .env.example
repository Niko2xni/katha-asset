# ==========================================
# Database Configuration (Supabase/PostgreSQL)
# ==========================================
# Connection pooler string (Port 6543) - Used for serverless API routes
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection string
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=3&pool_timeout=15"

# Direct connection string (Port 5432) - Used for running structural migrations (Prisma)
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection string (Session mode)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres"

# ==========================================
# Authentication (Auth.js / NextAuth)
# ==========================================
# Core secret used to encrypt session tokens
# Generate via: `npx auth secret` or `openssl rand -base64 33`
BETTER_AUTH_SECRET="your-32-byte-base64-secret-here"

# Application Base URL for OAuth redirects
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# GitHub OAuth App Credentials
# Obtain from: GitHub Settings -> Developer settings -> OAuth Apps
AUTH_GITHUB_ID="your_github_client_id"
AUTH_GITHUB_SECRET="your_github_client_secret"

# Google OAuth Credentials
# Obtain from: Google Cloud Console -> APIs & Services -> Credentials
AUTH_GOOGLE_ID="your_google_client_id"
AUTH_GOOGLE_SECRET="your_google_client_secret"

# ==========================================
# Payment Gateway (PayMongo)
# ==========================================
# Obtain from: PayMongo Dashboard -> Developers -> API Keys
PAYMONGO_PUBLIC_KEY="pk_test_your_public_key"
PAYMONGO_SECRET_KEY="sk_test_your_secret_key"

# Webhook signature for validating incoming payment events
# Obtain from: PayMongo Dashboard -> Developers -> Webhooks
PAYMONGO_WEBHOOK_SECRET="whsk_your_webhook_secret_key"

# ==========================================
# Supabase Backend & Storage
# ==========================================
# Obtain from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_public_key"
SUPABASE_SECRET_KEY="your_service_role_secret_key"

# ==========================================
# AI Integration (Google Gemini SDK)
# ==========================================
# Obtain from: Google AI Studio -> Get API Key
GOOGLE_GENERATIVE_AI_API_KEY="your_google_gemini_api_key"
